# Optional Compose model/storage overrides. Set the API key through Kakuoku settings.
# Custom launches may use GHOSTMETAL_API_KEY as a server-only fallback;
# the supplied Compose deliberately does not pass that secret in the environment.
GHOSTMETAL_MODEL=glm-5.3-long
KAKUOKU_DATA_VOLUME=kakuoku-production-data

# Optional host folder, only with compose.override.example.yaml copied to
# compose.override.yaml. Set your own existing absolute path in a local .env.
# Do not commit .env or compose.override.yaml. Do not switch existing data
# to an empty folder; see docs/deployment.md first.
# KAKUOKU_DATA_DIR=
